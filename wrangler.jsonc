{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "falling-morning-0e00",
  "main": "src/index.js",
  "compatibility_date": "2026-09-19",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },

  "kv_namespaces": [
    {
      "binding": "LATEST_SCORES",
      "id": "cdbc8dfd04c24dde8e277d7f66bd67e0"
    }
  ],

  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  }
}