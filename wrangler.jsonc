{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "falling-morning-0e00",
  "main": "src/index.js",
  "compatibility_date": "2026-09-19",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },

  // KV now caches scores, fixtures, news, videos and the AI briefing.
  // The cron below refreshes it every 15 minutes, so visitors are served
  // from cache and football-data.org rate limits are never hit.
  "kv_namespaces": [
    {
      "binding": "LATEST_SCORES",
      "id": "cdbc8dfd04c24dde8e277d7f66bd67e0"
    }
  ],

  // Cloudflare Workers AI — writes the daily matchday briefing.
  // Remove this block to switch AI off; the site falls back to a
  // plain summary automatically.
  "ai": {
    "binding": "AI"
  },

  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  }
}
